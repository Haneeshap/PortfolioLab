# Copy to .env and replace the placeholder with your local Postgres password.
# Must match the DB_PASSWORD used by the Docker Compose PostgreSQL service.
DB_PASSWORD=replace_with_your_own_local_password

# Full SQLAlchemy async URL (asyncpg driver). If omitted, it is built from
# DB_HOST/DB_PORT/DB_USER/DB_NAME/DB_PASSWORD below.
DATABASE_URL=postgresql+asyncpg://portfoliolab:replace_with_your_own_local_password@localhost:5432/portfoliolab

DB_HOST=localhost
DB_PORT=5432
DB_USER=portfoliolab
DB_NAME=portfoliolab

# Ollama embedding server (same endpoint used by the Java OllamaEmbeddingClient).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Backend
BACKEND_URL=http://127.0.0.1:8000
BACKEND_PORT=8000

# CORS allowed origins (comma-separated). "*" allows all local origins.
CORS_ORIGINS=*

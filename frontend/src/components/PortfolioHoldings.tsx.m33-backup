"use client";

import { useRef, useState } from "react";
import TradeForm from "@/components/TradeForm";
import PortfolioAllocation from "@/components/PortfolioAllocation";
import {
  formatMoney,
  usePortfolioData,
} from "@/components/usePortfolioData";

type Asset = {
  id: number;
  symbol: string;
  name: string;
  price: number;
  currency: string;
};

export default function PortfolioHoldings({ assets }: { assets: Asset[] }) {
  const [allocationOpen, setAllocationOpen] = useState(false);
  const [tradeOpen, setTradeOpen] = useState(false);
  const tradeDetailsRef = useRef<HTMLDetailsElement>(null);
  const [holdingTradeRequest, setHoldingTradeRequest] = useState<{
    assetId: number;
    sequence: number;
  } | null>(null);

  const {
    portfolio,
    holdings,
    loading,
    error,
    refresh,
    holdingsValue,
    investedAmount,
    unrealizedProfitLoss,
    totalValue,
    isPortfolioLive,
  } = usePortfolioData();

  function openTrade(assetId?: number) {
    if (assetId !== undefined) {
      setHoldingTradeRequest((previous) => ({
        assetId,
        sequence: (previous?.sequence ?? 0) + 1,
      }));
    }
    setTradeOpen(true);
    requestAnimationFrame(() => {
      tradeDetailsRef.current?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    });
  }

  if (loading) {
    return <p className="text-slate-400">Loading portfolio...</p>;
  }

  if (error || !portfolio) {
    return <p className="text-red-400">{error ?? "Portfolio unavailable"}</p>;
  }

  const metrics = [
    { label: "Holdings value", value: holdingsValue },
    { label: "Invested amount", value: investedAmount },
    { label: "Unrealized P&L", value: unrealizedProfitLoss, pnl: true },
    { label: "Available cash", value: portfolio.cashBalance },
  ];

  return (
    <section className="space-y-5">
      <header className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 className="text-2xl font-semibold">My Portfolio</h2>
          <p className="mt-1 text-sm text-slate-400">
            {portfolio.name} · {portfolio.currency} · Simulated
          </p>
        </div>
        <button
          type="button"
          onClick={() => openTrade()}
          className="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400"
        >
          Place trade
        </button>
      </header>

      <div className="rounded-xl border border-slate-800 bg-slate-900 p-4 sm:p-5">
        <div className="flex flex-wrap items-end justify-between gap-2 border-b border-slate-800 pb-4">
          <div>
            <p className="text-xs text-slate-400">Total portfolio value (including cash)</p>
            <p className="mt-1 text-2xl font-semibold tabular-nums sm:text-3xl">
              {formatMoney(totalValue, portfolio.currency)}
            </p>
          </div>
          <p className="text-xs text-slate-400">
            {isPortfolioLive ? "Live simulated prices" : "Reference / mixed prices"}
          </p>
        </div>
        <div className="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
          {metrics.map((metric) => (
            <div key={metric.label} className="min-w-0">
              <p className="text-xs text-slate-400">{metric.label}</p>
              <p
                className={`mt-1 break-words text-sm font-semibold tabular-nums sm:text-base ${
                  metric.pnl
                    ? metric.value >= 0
                      ? "text-emerald-400"
                      : "text-red-400"
                    : "text-slate-100"
                }`}
              >
                {formatMoney(metric.value, portfolio.currency)}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div className="overflow-hidden rounded-xl border border-slate-800 bg-slate-900">
        <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 px-4 py-4 sm:px-5">
          <div>
            <h3 className="text-lg font-semibold">Holdings</h3>
            <p className="text-xs text-slate-400">{holdings.length} assets · Values in {portfolio.currency}</p>
          </div>
          <span className="text-xs text-slate-400">Unrealized returns</span>
        </div>
        {holdings.length === 0 ? (
          <p className="p-5 text-sm text-slate-400">You don't own any assets yet.</p>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full min-w-[650px] text-left text-sm">
              <thead className="bg-slate-800/40 text-xs text-slate-400">
                <tr>
                  <th className="px-4 py-3 font-medium sm:px-5">Asset</th>
                  <th className="px-4 py-3 font-medium">Quantity</th>
                  <th className="px-4 py-3 font-medium">Avg. buy</th>
                  <th className="px-4 py-3 font-medium">Current value</th>
                  <th className="px-4 py-3 font-medium">P&L</th>
                  <th className="px-4 py-3 font-medium">Action</th>
                </tr>
              </thead>
              <tbody>
                {holdings.map((holding) => (
                  <tr key={holding.assetId} className="border-t border-slate-800">
                    <td className="px-4 py-3 sm:px-5">
                      <p className="font-semibold text-slate-100">{holding.symbol}</p>
                      <p className="text-xs text-slate-400">{holding.name}</p>
                    </td>
                    <td className="px-4 py-3 tabular-nums">{holding.quantity}</td>
                    <td className="px-4 py-3 tabular-nums">
                      {formatMoney(holding.averageBuyPrice, holding.currency)}
                    </td>
                    <td className="px-4 py-3 tabular-nums">
                      {formatMoney(holding.marketValueInPortfolioCurrency, portfolio.currency)}
                    </td>
                    <td className={`px-4 py-3 font-medium tabular-nums ${
                      holding.unrealizedProfitLossInPortfolioCurrency >= 0
                        ? "text-emerald-400"
                        : "text-red-400"
                    }`}>
                      {formatMoney(holding.unrealizedProfitLossInPortfolioCurrency, portfolio.currency)}
                    </td>
                    <td className="px-4 py-3">
                      <button
                        type="button"
                        onClick={() => openTrade(holding.assetId)}
                        className="rounded-md border border-emerald-500/50 px-3 py-1.5 text-xs font-semibold text-emerald-300 hover:bg-emerald-500/10"
                      >
                        Trade
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <details
        open={allocationOpen}
        onToggle={(event) => setAllocationOpen(event.currentTarget.open)}
        className="rounded-xl border border-slate-800 bg-slate-900"
      >
        <summary className="cursor-pointer px-5 py-4 font-medium">Portfolio allocation</summary>
        <div className="border-t border-slate-800 p-3">
          {allocationOpen && (
            <PortfolioAllocation
              portfolio={portfolio}
              holdings={holdings}
              totalValue={totalValue}
              isPortfolioLive={isPortfolioLive}
            />
          )}
        </div>
      </details>

      <details
        ref={tradeDetailsRef}
        open={tradeOpen}
        onToggle={(event) => setTradeOpen(event.currentTarget.open)}
        className="scroll-mt-6 rounded-xl border border-slate-800 bg-slate-900"
      >
        <summary className="cursor-pointer px-5 py-4 font-medium">Simulated trading</summary>
        <div className="border-t border-slate-800 p-3">
          {tradeOpen && (
            <TradeForm
              assets={assets}
              portfolio={portfolio}
              holdings={holdings}
              onTradeCompleted={refresh}
              holdingTradeRequest={holdingTradeRequest}
            />
          )}
        </div>
      </details>
    </section>
  );
}
